# Vigilux Sentinel frontend configuration
# Copy to .env (this frontend/ directory) and adjust.

# Base URL of the deployed backend (Cloud Run). No trailing slash.
# Leave empty and set VITE_DEMO=true to run purely on mock data.
# VITE_API_URL=https://vigilux-api-xxxx-uc.a.run.app

# When "true", the app renders seeded mock data and a simulated fleet sweep so
# the UI can be demoed without a live backend (or without CORS being wired up).
VITE_DEMO=true
