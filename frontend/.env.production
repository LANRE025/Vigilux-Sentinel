# Production build: call the hosted backend directly (no dev proxy).
# Requires the backend to have CORS enabled (CORSMiddleware is in
# backend/main.py) so the deployed frontend can reach it cross-origin.
#
# VITE_API_URL is injected at build time via --build-arg in the Dockerfile.
# The value here is the default for local `npm run build`; the deploy script
# overrides it with BACKEND_URL.
VITE_PROXY=false
VITE_API_URL=
VITE_DEMO=false
