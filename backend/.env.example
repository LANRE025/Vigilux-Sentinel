# Vigilux Sentinel configuration
# Copy to .env (this backend/ directory) and fill in the values you need.

# --- Google Cloud --------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
# Firestore database region. Independent from where Gemini is reached.
FIRESTORE_REGION=us-central1
# Leave empty to use the (default) Firestore database.
FIRESTORE_DATABASE=

# --- Gemini (Vertex AI via Application Default Credentials) ---------------
# Gemini is called through Vertex AI; authentication comes entirely from
# Application Default Credentials (gcloud auth application-default login).
# No API key is needed or read by the fleet.
GEMINI_MODEL=gemini-3.5-flash
# gemini-3.5-flash requires the global Vertex AI location.
GEMINI_VERTEX_LOCATION=global
# Optional, UNUSED by default: a Gemini Developer API key. The fleet does not
# read this value - keep it only if you re-add the API-key path locally
# instead of Vertex AI.
GEMINI_API_KEY=

# --- Fleet policy --------------------------------------------------------
SURVEY_STALENESS_THRESHOLD_DAYS=30
# Data steward: regions this many days stale (or older) are flagged for
# evaluation. Boundary is inclusive (exactly 14 is evaluated).
DATA_STEWARD_STALENESS_THRESHOLD_DAYS=30
USE_HEURISTIC_FALLBACK=true

# --- Memory Bank (optional) ----------------------------------------------
# To use the real Vertex AI Agent Engine (Memory Bank) instead of the
# Firestore fallback, set the engine id of a provisioned Agent Engine.
MEMORY_BANK_AGENT_ENGINE_ID=
MEMORY_BANK_AGENT_ENGINE_LOCATION=global

# --- Observability -------------------------------------------------------
OTEL_CLOUD_TRACE_ENABLED=true

# --- Runtime -------------------------------------------------------------
LOG_LEVEL=INFO
PORT=8080